-- ATL transformation skeleton: UML XMI -> AST model
-- This is a minimal, illustrative ATL module. You'll need proper metamodels registered (UML and your AST metamodel).
-- Replace metamodel names according to your environment.

module UML2AST;

create OUT : AST from IN : UML;

-- Example rule mapping UML Classes to AST::Class
rule Class2AST {
  from
    c : UML!Class
  to
    ac : AST!Class (
      name <- c.name,
      attributes <- c.ownedAttribute->collect(a | thisModule.Attribute2Field(a))
    )
}

-- helper rule for attributes
rule Attribute2Field {
  from
    a : UML!Property
  to
    f : AST!Field (
      name <- a.name,
      type <- a.type
    )
}

-- Add more rules for operations, associations, instances, etc.
-- Use OCL in `when` clauses and `do` blocks to refine mappings.
